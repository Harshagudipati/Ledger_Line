# ============================================================================
# LedgerLine / BalanceVault Environment Configuration Example
# Copy to `.env` for local development or inject via platform secret manager.
# Never commit real `.env` secrets to version control.
# ============================================================================

NODE_ENV=development
PORT=8080

# Required in NODE_ENV=production (use >= 32 random bytes, e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-random-64-char-hex-secret

# Database Backend:
# - Default (unset): Embedded SQLite WAL at backend/ledgerline.sqlite
# - Production Postgres: postgres://ledgerline_app:password@host:5432/ledgerline_db
DB_PATH=backend/ledgerline.sqlite
# DATABASE_URL=postgres://user:password@localhost:5432/ledgerline_db

# Rate Limiting Backend:
# - Default (unset): In-memory sliding window store
# - Distributed Redis: redis://localhost:6379
# REDIS_URL=redis://localhost:6379
AUTH_RATE_LIMIT_MAX=30
RATE_LIMIT_MAX_REQUESTS=500
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_MS=900000

# Optional Seed Credentials (used when running `node backend/src/db/seed.js`
# or booting an empty non-production database)
SEED_DEMO_USERS=true
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_AUDITOR_PASSWORD=AuditorPassword123!
SEED_ALICE_PASSWORD=AlicePassword123!
SEED_BOB_PASSWORD=BobPassword123!
SEED_CHARLIE_PASSWORD=CharliePassword123!
